// Librerias
//--------------------------------------------
#include <Arduino.h>
#include <stdint.h>

//--------------------------------------------
// Definiciones
//--------------------------------------------
#define LM35 39
#define boton 36






//--------------------------------------------
// Prototipos de funciones
//--------------------------------------------
  float temperatura();




//--------------------------------------------
// Variables globales
//--------------------------------------------
float celcius = 0.0;
volatile bool estadoboton = false;



//--------------------------------------------
// ISRs Rutinas de Interrupcion
//--------------------------------------------
void IRAM_ATTR botonISR(){
  estadoboton = true;
}
//--------------------------------------------
// Configuracion
//--------------------------------------------
void setup(){
  
  Serial.begin(115200);
  pinMode(LM35, INPUT);
  pinMode(boton, INPUT);
  attachInterrupt(digitalPinToInterrupt(boton), botonISR, RISING);
}
//--------------------------------------------
// Loop Principal
//--------------------------------------------
void loop() {
  if(estadoboton){

    celcius = temperatura();
    Serial.print(" Temperatura: ");
    Serial.println(celcius);
    Serial.println(analogRead(LM35));

  


    estadoboton = false;
   }

  
}
//--------------------------------------------
// Otras funciones
float temperatura(){
  int adc = analogRead(LM35);
  float voltaje = adc * 3.32 / 4095.0;
  float temp = (voltaje * 100) ;
  return temp;
  
  
}
