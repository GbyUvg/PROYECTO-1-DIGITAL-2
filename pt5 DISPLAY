// Librerias
//--------------------------------------------
#include <Arduino.h>
#include <stdint.h>

//--------------------------------------------
// Definiciones
//--------------------------------------------
#define LM35 39
#define boton 36
#define rojo 26
#define verde 25
#define azul 33
#define servo 27
#define a 15
#define b 23
#define c 22
#define d 21 
#define e 19
#define f 18
#define g 5
#define dp 4
#define du 13
#define dd 12
#define dt 14






//--------------------------------------------
// Prototipos de funciones
//--------------------------------------------
float temperatura();
void rgb(int red, int green, int blue);
void mservo(int angulo);
void apagado();
void displayn(int numero);
void separacion();
void numeros();




//--------------------------------------------
// Variables globales
//--------------------------------------------
float celcius = 0.0;
volatile bool estadoboton = false;
int angulo = 0;
int tempdisplay = 0;
int decenas = 0;
int unidades = 0;
int decimal = 0;




//--------------------------------------------
// ISRs Rutinas de Interrupcion
//--------------------------------------------
void IRAM_ATTR botonISR(){
  estadoboton = true;
}
//--------------------------------------------
// Configuracion
//--------------------------------------------
void setup(){
  
  Serial.begin(115200);
  pinMode(LM35, INPUT);
  pinMode(boton, INPUT);
  ledcSetup(0, 5000, 8); //para el rojo
  ledcSetup(1, 5000, 8);  // verde
  ledcSetup(2, 5000, 8); // azul
  ledcAttachPin(rojo, 0);
  ledcAttachPin(verde, 1);
  ledcAttachPin(azul, 2);
  ledcSetup(3, 50, 16); //  servo
  ledcAttachPin(servo, 3);
  pinMode(a, OUTPUT);
  pinMode(b, OUTPUT);
  pinMode(c, OUTPUT);
  pinMode(d, OUTPUT);
  pinMode(e, OUTPUT);
  pinMode(f, OUTPUT);
  pinMode(g, OUTPUT);
  pinMode(dp, OUTPUT);
  pinMode(du, OUTPUT);
  pinMode(dd, OUTPUT);
  pinMode(dt, OUTPUT);
  attachInterrupt(digitalPinToInterrupt(boton), botonISR, RISING);
  apagado();


}
//--------------------------------------------
// Loop Principal
//--------------------------------------------
void loop() {
  numeros();
  

  if(estadoboton){

    celcius = temperatura();
    Serial.print(" Temperatura: ");
    Serial.println(celcius);
    separacion();
   
    if(celcius <23){
      Serial.println("Estado: Riesgo por frio");
      rgb(0, 0, 255); // Azul
      mservo(0); // cerrado
    }
    else if(celcius >= 23 && celcius < 25){
      Serial.println("Estado: Rango seguro");
      rgb(0, 255, 0); // Verde
      mservo(90); // medio
    }
    else if(celcius >= 25 && celcius < 27){
      Serial.println("Estado: Cerca del limite");
      rgb(255, 230, 0); // Amarillo
      mservo(90); // medio
    }
    else if(celcius >= 27){
      Serial.println("Estado: Riesgo por calor");
      rgb(255, 0, 0); // Rojo
      mservo(180); // abierto
    }

    estadoboton = false;
   }

  
}
//--------------------------------------------
// Otras funciones
float temperatura(){
  int adc = analogRead(LM35);
  float voltaje = adc * 3.32 / 4095.0;
  float temp = (voltaje * 100) + 7 ;
  return temp;

  
}

void rgb(int red, int green, int blue){
  ledcWrite(0, red);
  ledcWrite(1, green);  
  ledcWrite(2,blue);
}

void mservo(int angulo){
  int dutyc = map(angulo,0,180,3277,6554);
  ledcWrite(3,dutyc);
}
void apagado(){
  digitalWrite(a,LOW);
  digitalWrite(b,LOW);
  digitalWrite(c,LOW);
  digitalWrite(d,LOW);
  digitalWrite(e,LOW);
  digitalWrite(f,LOW);
  digitalWrite(g,LOW);
  digitalWrite(dp,LOW);
  digitalWrite(du,LOW);
  digitalWrite(dd,LOW);
  digitalWrite(dt,LOW);
  rgb(0,0,0);
  mservo(0);
}

void displayn(int numero){
  switch(numero){
    case 0:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,HIGH);
      digitalWrite(g,LOW);
      break;

    case 1:
      digitalWrite(a,LOW);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,LOW);
      digitalWrite(e,LOW);
      digitalWrite(f,LOW);
      digitalWrite(g,LOW);
      break;

    case 2:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,LOW);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,LOW);
      digitalWrite(g,HIGH);
      break;

    case 3:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,LOW);
      digitalWrite(f,LOW);
      digitalWrite(g,HIGH);
      break;

    case 4:
      digitalWrite(a,LOW);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,LOW);
      digitalWrite(e,LOW);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 5:
      digitalWrite(a,HIGH);
      digitalWrite(b,LOW);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,LOW);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 6:
      digitalWrite(a,HIGH);
      digitalWrite(b,LOW);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 7:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH); 
      digitalWrite(d,LOW);
      digitalWrite(e,LOW);
      digitalWrite(f,LOW);
      digitalWrite(g,LOW);
      break;
    
    case 8:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 9:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,LOW);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;
  }
}

void separacion(){
  tempdisplay = celcius*10;
  decenas = tempdisplay / 100;
  tempdisplay = tempdisplay - (decenas * 100);
  unidades = tempdisplay / 10;
  tempdisplay = tempdisplay - (unidades * 10);
  decimal = tempdisplay;
}

void numeros(){
    digitalWrite(du, LOW);
    digitalWrite(dd, LOW);
    digitalWrite(dt, LOW);

    // Dígito 1 decenas
    displayn(decenas);
    digitalWrite(du, HIGH);
    delay(5);
    digitalWrite(du, LOW);

    // Dígito 2 unidades
    displayn(unidades);
    digitalWrite(dp,HIGH);
    digitalWrite(dd, HIGH);
    delay(5);
    digitalWrite(dd, LOW);
    digitalWrite(dp,LOW);

    // Dígito 3 decimal
    displayn(decimal);
    digitalWrite(dt, HIGH);
    delay(5);
    digitalWrite(dt, LOW);
}

