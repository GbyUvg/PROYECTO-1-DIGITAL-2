// Librerias
//--------------------------------------------
#include <Arduino.h>
#include <stdint.h>

//--------------------------------------------
// Definiciones
//--------------------------------------------
#define LM35 39
#define boton 36
#define rojo 26
#define verde 25
#define azul 33
#define servo 27
#define a 2
#define b 23
#define c 22
#define d 21 
#define e 19
#define f 18
#define g 5
#define dp 4
#define du 13
#define dd 12
#define dt 14


//--------------------------------------------
// Prototipos de funciones
//--------------------------------------------
float temperatura();
void rgb(int red, int green, int blue);
void mservo(int angulo);
void displayn(int numero);
void separacion();
void numeros();



//--------------------------------------------
// Variables globales
//--------------------------------------------
float celcius = 0.0;
volatile bool estadoboton = false;
int angulo = 0;
int temp = 0;
int clima = 0;
int dec = 0;
int uni = 0;
int decimal = 0;



//--------------------------------------------
// ISRs Rutinas de Interrupcion
//--------------------------------------------
void IRAM_ATTR botonISR(){
  estadoboton = true;
}
//--------------------------------------------
// Configuracion
//--------------------------------------------
void setup(){
  
  Serial.begin(115200);
  pinMode(LM35, INPUT);
  pinMode(boton, INPUT);
  ledcSetup(0, 5000, 8); //para el rojo
  ledcSetup(1, 5000, 8);  // verde
  ledcSetup(2, 5000, 8); // azul
  ledcAttachPin(rojo, 0);
  ledcAttachPin(verde, 1);
  ledcAttachPin(azul, 2);
  ledcSetup(3, 50, 16); //  servo
  ledcAttachPin(servo, 3);
  pinMode(a, OUTPUT);
  pinMode(b, OUTPUT);
  pinMode(c, OUTPUT);
  pinMode(d, OUTPUT);
  pinMode(e, OUTPUT);
  pinMode(f, OUTPUT);
  pinMode(g, OUTPUT);
  pinMode(dp, OUTPUT);
  pinMode(du, OUTPUT);
  pinMode(dd, OUTPUT);
  pinMode(dt, OUTPUT);
  attachInterrupt(digitalPinToInterrupt(boton), botonISR, RISING);
}
//--------------------------------------------
// Loop Principal
//--------------------------------------------
void loop() {
 
  if(estadoboton){
   

    celcius = temperatura();
    separacion();
    Serial.print(" Temperatura: ");
    Serial.println(celcius);

    numeros();
    if(celcius <23){
      Serial.println("Estado: Riesgo por frio");
      rgb(0, 0, 255); // Azul
      mservo(0); // cerrado
    }
    else if(celcius >= 23 && celcius < 25){
      Serial.println("Estado: Rango seguro");
      rgb(0, 255, 0); // Verde
      mservo(90); // medio
    }
    else if(celcius >= 25 && celcius < 27){
      Serial.println("Estado: Cerca del limite");
      rgb(255, 230, 0); // Amarillo
      mservo(90); // medio
    }
    else if(celcius >= 27){
      Serial.println("Estado: Riesgo por calor");
      rgb(255, 0, 0); // Rojo
      mservo(180); // abierto
    }


    estadoboton = false;
   }

  

  
}
//--------------------------------------------
// Otras funciones
float temperatura(){
  int adc = analogRead(LM35);
  float voltaje = adc * 3.32 / 4095.0;
  float temp = (voltaje * 100) + 10 ;
  return temp;

  
}

void rgb(int red, int green, int blue){
  ledcWrite(0, red);
  ledcWrite(1, green);  
  ledcWrite(2,blue);
}

void mservo(int angulo){
  int dutyc = map(angulo,0,180,3277,6554);
  ledcWrite(3,dutyc);
}


void displayn(int numero){

  switch(numero){

    case 0:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,HIGH);
      digitalWrite(g,LOW);
      break;

    case 1:
      digitalWrite(a,LOW);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,LOW);
      digitalWrite(e,LOW);
      digitalWrite(f,LOW);
      digitalWrite(g,LOW);
      break;

    case 2:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,LOW);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,LOW);
      digitalWrite(g,HIGH);
      break;

    case 3:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,LOW);
      digitalWrite(f,LOW);
      digitalWrite(g,HIGH);
      break;

    case 4:
      digitalWrite(a,LOW);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,LOW);
      digitalWrite(e,LOW);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 5:
      digitalWrite(a,HIGH);
      digitalWrite(b,LOW);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,LOW);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 6:
      digitalWrite(a,HIGH);
      digitalWrite(b,LOW);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 7:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH); 
      digitalWrite(d,LOW);
      digitalWrite(e,LOW);
      digitalWrite(f,LOW);
      digitalWrite(g,LOW);
      break;
    
    case 8:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,HIGH);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;

    case 9:
      digitalWrite(a,HIGH);
      digitalWrite(b,HIGH);
      digitalWrite(c,HIGH);
      digitalWrite(d,HIGH);
      digitalWrite(e,LOW);
      digitalWrite(f,HIGH);
      digitalWrite(g,HIGH);
      break;
    
  }
}
void separacion(){

    clima = celcius * 10;
    dec = clima / 100;
    clima = clima - (dec * 100);
    uni = clima / 10;
    decimal = clima - (uni * 10);

}

void numeros(){

  displayn(dec);
  digitalWrite(dd, HIGH);
  delay(5);
  digitalWrite(dd, LOW);
  digitalWrite(du,LOW);
  digitalWrite(dd,HIGH);
  digitalWrite(dt,HIGH);
  delay(5);

  displayn(uni);
  digitalWrite(du, HIGH);
  delay(5);
  digitalWrite(du, LOW);
  digitalWrite(dd,LOW);
  digitalWrite(dt,HIGH);
  delay(5);

  displayn(decimal);
  digitalWrite(dt, HIGH);
  delay(5);
  digitalWrite(dt, LOW);
  digitalWrite(du,HIGH);
  digitalWrite(dd,HIGH);
  digitalWrite(dt,LOW);
  delay(5);

  displayn(uni);
  digitalWrite(dp, HIGH);

}



